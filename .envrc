# 1. 加载 shell.nix 中定义的 Nix 环境
use nix

# 2. 定义 virtualenv 目录名称
VENV_DIR="venv"

# 3. 检查并创建 virtualenv (只在第一次进入时执行)
if [ ! -d "$VENV_DIR" ]; then
    echo "Virtual environment '$VENV_DIR' not found. Creating..."
    # 使用 Nix shell 提供的 virtualenv 命令创建环境
    virtualenv "$VENV_DIR"
    echo "Virtual environment created."
fi

# 4. 激活 virtualenv，并修改终端提示符
source "$VENV_DIR/bin/activate"

